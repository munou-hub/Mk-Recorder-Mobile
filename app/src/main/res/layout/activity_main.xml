<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnTabRec"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="録音"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_primary" />

        <Button
            android:id="@+id/btnTabLib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="試聴"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_secondary" />

        <Button
            android:id="@+id/btnTabSet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="設定"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/viewRecord"
            layout="@layout/view_record"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/viewLibrary"
            layout="@layout/view_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/viewSettings"
            layout="@layout/view_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/viewFx"
            layout="@layout/view_fx"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
