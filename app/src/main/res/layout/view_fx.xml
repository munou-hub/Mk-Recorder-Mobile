<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="エフェクト（EQ → コンプ）"
            android:textSize="16sp"
            android:textColor="@color/text_main" />

        <Button
            android:id="@+id/btnFxClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="閉じる"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="再生にリアルタイムで掛かります（原音は不変）。書き出しは試聴画面の長押しメニューから。"
        android:textSize="11sp"
        android:textColor="@color/text_sub" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EQ（4バンド パラメトリック）"
                        android:textSize="14sp"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btnFxEqOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ OFF"
                        android:textColor="@color/text_main"
                        android:background="@drawable/bg_button_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fxEqContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="コンプレッサー"
                        android:textSize="14sp"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btnFxCompOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMP OFF"
                        android:textColor="@color/text_main"
                        android:background="@drawable/bg_button_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GR"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub" />

                    <jp.mk.recorder.GrView
                        android:id="@+id/grViewFx"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tvGrValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0.0 dB"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fxCompContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnFxReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="全パラメータをリセット"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_button_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
